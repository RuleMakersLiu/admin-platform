EGRESS_TRIAL_SIGNING_KEY=replace-with-at-least-32-random-characters
EGRESS_EXECUTION_ENABLED=false
EGRESS_APPROVED_GATE_REFERENCE=
EGRESS_BUDGET_STORE=disabled
EGRESS_REDIS_ADDRESS=127.0.0.1:6379
EGRESS_REDIS_PASSWORD=
EGRESS_REDIS_DB=0
EGRESS_DESTINATIONS_JSON=[]
# Vault Agent writes credentials to a memory-backed file. Configure only the
# path, for example EGRESS_SECRET_FILE_MODEL_A=/vault/secrets/model-a.
