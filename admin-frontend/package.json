{
  "name": "admin-frontend",
  "version": "1.0.0",
  "description": "后台管理系统前端",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run",
    "test:portal": "node tests/portal-routing.test.mjs",
    "test:sanitize": "vitest run tests/sanitize.test.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.12.0",
    "antd": "^6.6.8",
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "dompurify": "^3.3.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "highlight.js": "^11.11.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.1.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
